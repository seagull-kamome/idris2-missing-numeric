package missing-numeric

brief   = "Some numeric data types of Idris2"
version = 0.7.0
authors = "HATTORI, Hiroki <seagull.kamome@gmail.com>"
license = "MIT"

langversion >= 0.5.1

sourcedir = "src"
depends   = base
          , contrib
          , elab-util >= 0.6.0
          , sop >= 0.6.0

modules = Data.Pow
        , Data.Ring.Laws
        , Data.Integer.Laws
        , Data.Rational
        , Data.Rational.Laws
        , Data.Fixed
        , Data.Complex
        , Data.Complex.Laws
        , Text.Format.Decimal
        , Text.Format.Digits

